digraph Ecommerce {
graph [layout=dot, rankdir=LR, bgcolor="white", splines=polyline, nodesep=0.5, ranksep=1.00, pad=0.3, labelloc=t, label="MODELO LÓGICO RELACIONAL — E-COMMERCE\n15 tabelas | chaves e relacionamentos", fontname="DejaVu Sans", fontsize=22, fontcolor="#203B56", outputorder=edgesfirst];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#8C9BAA", penwidth=1.15, arrowsize=0.6, fontname="DejaVu Sans", fontsize=10];
"CLIENTE" [label=<<TABLE BORDER="1" COLOR="#2C667C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#2C667C" ALIGN="CENTER" COLSPAN="2"><FONT COLOR="white"><B>CLIENTE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EDF2F7"><FONT POINT-SIZE="10" COLOR="#36536D">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id_cliente</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EDF2F7"><FONT POINT-SIZE="10" COLOR="#36536D">—</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">nome · email (UK)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EDF2F7"><FONT POINT-SIZE="10" COLOR="#36536D">—</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">telefone · tipo_cliente</FONT></TD></TR></TABLE>>];
